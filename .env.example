# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Vett content pipeline only needs these for the OPTIONAL auto-upload stage.
# The video GENERATION itself needs no API keys at all.

# YouTube Data API v3 (for auto-posting Shorts) — from Google Cloud Console
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Optional: override tool locations (defaults assume ~/tools from setup.sh)
# FFMPEG=/home/you/tools/ffmpeg
# PIPER=/home/you/tools/piper/piper
